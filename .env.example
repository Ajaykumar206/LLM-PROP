# Google Gemini API Key for material scientific text description & reasoning
GEMINI_API_KEY=

# Materials Project API Key for crystal structure fetching & CIF generation
MP_API_KEY=

# Optional OpenAI API Key (fallback if Gemini is not configured)
OPENAI_API_KEY=

# Server Configuration (On Render, PORT is dynamically injected)
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=*

# Optional: URL to download fine-tuned T5 model weights during Render build
# e.g., https://huggingface.co/.../model.safetensors or direct cloud storage URL
MODEL_WEIGHTS_URL=

# Frontend (Only needed if deploying frontend separately as a Render Static Site)
VITE_API_URL=
